package main

import (
	"context"
	"encoding/json"
	"net/http"
	"net/http/httptest"
	"strings"
	"testing"

	"github.com/usermind/wpsync/internal/agentapi"
	"github.com/usermind/wpsync/internal/cliout"
)

const activityAnswer = `{"since":1762218000,"until":1762304400,"checked":1762304400,"log_since":1762000000,
"agent_version":"0.11.0","core":"6.8.3","events":[
 {"at":1762226040,"kind":"updated","type":"plugin","slug":"akismet","name":"Akismet","from":"5.3","to":"5.3.1","source":"auto","user":null,"detail":null},
 {"at":1762226100,"kind":"update_failed","type":"plugin","slug":"woocommerce","name":"WooCommerce","from":null,"to":null,"source":"auto","user":null,"detail":"download_failed"},
 {"at":1762290000,"kind":"activated","type":"plugin","slug":"wp-mail-smtp","name":"WP Mail SMTP","from":null,"to":null,"source":"user","user":{"id":3,"login":"redaktion"},"detail":null}
],"truncated":false,"auto_updates":{"plugins":["akismet"],"themes":[]}}`

// activitySite pairs "kunde" with a fake agent; missing: an agent before 0.11.0.
func activitySite(t *testing.T, missing bool) *[]map[string]any {
	t.Helper()
	env(t)
	var bodies []map[string]any
	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		if missing || r.URL.Query().Get("rest_route") != agentapi.ActivityRoute {
			http.Error(w, `{"code":"rest_no_route","message":"no route"}`, http.StatusNotFound)
			return
		}
		var b map[string]any
		json.NewDecoder(r.Body).Decode(&b)
		bodies = append(bodies, b)
		w.Write([]byte(activityAnswer))
	}))
	t.Cleanup(srv.Close)
	paired(t, "kunde", srv.URL)
	return &bodies
}

func act(t *testing.T, args ...string) result {
	t.Helper()
	return run(t, context.Background(), testSecret+"\n", append(append([]string{"activity"}, args...), "--secret-stdin")...)
}

// NB-14
func TestActivityJSON(t *testing.T) {
	bodies := activitySite(t, false)
	res := act(t, "kunde", "--json", "--since", "1762218000", "--until", "1762304400", "--limit", "50")
	m := lastResult(t, res, "activity", 0)
	d := requireKeys(t, m["data"], "site", "since", "until", "checked", "log_since", "agent_version", "core", "events", "truncated", "auto_updates")
	if d["site"] != "kunde" || len(d["events"].([]any)) != 3 {
		t.Errorf("data = %v", d)
	}
	b := (*bodies)[0]
	if b["since"] != float64(1762218000) || b["until"] != float64(1762304400) || b["limit"] != float64(50) {
		t.Errorf("body = %v", b)
	}
}

func TestActivityText(t *testing.T) {
	activitySite(t, false)
	res := act(t, "kunde", "--since", "1762218000", "--until", "1762304400")
	if res.code != 0 {
		t.Fatalf("exit %d: %s", res.code, res.stderr)
	}
	for _, want := range []string{
		"Aktivität auf kunde",
		"Plugin akismet 5.3 → 5.3.1 · aktualisiert · Auto-Update",
		"Plugin woocommerce · Update fehlgeschlagen (download_failed) · Auto-Update",
		"Plugin wp-mail-smtp · aktiviert · Benutzer redaktion",
		"Auto-Update an: 1 Plugins, 0 Themes",
	} {
		if !strings.Contains(res.stdout, want) {
			t.Errorf("missing %q in\n%s", want, res.stdout)
		}
	}
}

// NB-11: falsche Aufrufe fragen die Site nie.
func TestActivityUsageErrors(t *testing.T) {
	bodies := activitySite(t, false)
	for _, args := range [][]string{
		{"kunde", "--json", "--since", "40d"},
		{"kunde", "--json", "--since", "800h"},
		{"kunde", "--json", "--since", "-1h"},
		{"kunde", "--json", "--limit", "0"},
		{"kunde", "--json", "--limit", "501"},
		{"kunde", "--json", "--since", "1762304400", "--until", "1762218000"},
		{"--json"},
	} {
		res := act(t, args...)
		lastResult(t, res, "activity", cliout.ExitUsage)
	}
	if len(*bodies) != 0 {
		t.Errorf("requests = %v", *bodies)
	}
}

// NB-11: Agent 0.10.x
func TestActivityOldAgent(t *testing.T) {
	activitySite(t, true)
	m := lastResult(t, act(t, "kunde", "--json"), "activity", cliout.ExitAgentOutdated)
	if e := m["error"].(map[string]any); e["code"] != "agent_outdated" {
		t.Errorf("error = %v", e)
	}
}
